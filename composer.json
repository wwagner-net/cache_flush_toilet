{
	"name": "wwagner/cache-flush-toilet",
	"type": "typo3-cms-extension",
	"description": "Cache Flush Toilet - Plays a toilet flush sound whenever a backend user clears the cache. Purely for fun.",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"TYPO3",
		"extension",
		"cache",
		"fun",
		"sound"
	],
	"authors": [
		{
			"name": "Wolfgang Wagner",
			"email": "wwagner@wwagner.net",
			"role": "Developer"
		}
	],
	"homepage": "https://github.com/wwagner-net/cache_flush_toilet",
	"support": {
		"issues": "https://github.com/wwagner-net/cache_flush_toilet/issues",
		"source": "https://github.com/wwagner-net/cache_flush_toilet"
	},
	"require": {
		"php": "^8.2",
		"typo3/cms-backend": "^14.3",
		"typo3/cms-core": "^14.3"
	},
	"autoload": {
		"psr-4": {
			"WWagner\\CacheFlushToilet\\": "Classes/"
		}
	},
	"config": {
		"sort-packages": true
	},
	"extra": {
		"typo3/cms": {
			"extension-key": "cache_flush_toilet",
			"version": "1.0.0",
			"Package": {
				"providesPackages": {}
			}
		}
	}
}
